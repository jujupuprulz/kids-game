body {
  font-family: 'Comic Sans MS', cursive;
  background-color: #f0f8ff;
  text-align: center;
}

.container {
  margin: 20px auto;
  padding: 20px;
  max-width: 800px;
}

.game-area {
  height: 300px;
  border: 3px dashed #ff9900;
  border-radius: 15px;
  margin: 20px 0;
  position: relative;
}

.balloon {
  font-size: 50px;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  cursor: pointer;
  transition: all 0.3s;
}

button {
  background-color: #ff9900;
  border: none;
  color: white;
  padding: 10px 20px;
  border-radius: 20px;
  margin: 5px;
  font-size: 16px;
  cursor: pointer;
}
